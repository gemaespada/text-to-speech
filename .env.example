# =============================================================================
# Text to Speech - Plantilla de variables de entorno del backend (FastAPI)
# =============================================================================
# Copia este archivo como `.env` para ajustes locales o configura estas
# variables en el panel del proveedor de despliegue (por ejemplo, Render).
# No incluyas secretos ni credenciales en este archivo.

# Puerto en el que escucha Uvicorn (en Render se inyecta automáticamente)
PORT=8000

# Lista de orígenes permitidos por CORS (separados por comas, sin espacios adicionales)
# Ejemplo en producción con Cloudflare Pages:
# FRONTEND_ORIGINS=https://tu-proyecto.pages.dev,http://localhost:5173
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Ruta opcional donde NLTK busca y almacena los tokenizadores (punkt y punkt_tab)
# En Render se utiliza: /opt/render/project/src/.nltk_data
# NLTK_DATA=/opt/render/project/src/.nltk_data

# Límite máximo de caracteres permitidos en el texto extraído de un artículo
MAX_ARTICLE_CHARS=15000

# Configuración del limitador de peticiones en memoria (Rate Limiting por IP)
RATE_LIMIT_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=60
MAX_RATE_LIMIT_IPS=10000

# Configuración de confianza en cabeceras de proxy inverso (X-Forwarded-For)
# Mantener TRUST_PROXY_HEADERS=false hasta verificar la cadena de proxies real
# del entorno de despliegue.
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_CIDRS=
TRUSTED_PROXY_DEPTH=1

# Configuración de la caché en disco para conversiones por URL
TTS_CACHE_TTL_SECONDS=3600
TTS_CACHE_MAX_ENTRIES=50
TTS_CACHE_MAX_BYTES=104857600

# Clave API de ElevenLabs para el motor Eleven v4 (opcional: si se deja vacía,
# la aplicación sigue funcionando con el motor gratuito Edge TTS).
# Nunca subas tu clave real a GitHub; configúrala únicamente en `.env` local o en Render.
ELEVENLABS_API_KEY=
